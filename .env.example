# Copy this file to `.env` and fill in real values. Never commit `.env`.

# MongoDB connection string (MongoDB Atlas).
# Atlas -> Connect -> Drivers -> copy the string, then:
#   - replace <password> with your database user's password
#   - add the database name (magnetiq) before the "?"
DATABASE_URL="mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/magnetiq?retryWrites=true&w=majority"

# Signs admin and customer session cookies. Use a long random string.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET="change-me-to-a-long-random-string"

# Your WhatsApp business number, digits only with country code, no + or spaces.
WHATSAPP_NUMBER="201234567890"

# Your InstaPay number or address, shown to customers paying by InstaPay.
INSTAPAY_NUMBER="01000000000"

# Default delivery fee in EGP.
DELIVERY_FEE="50"

# Seeded admin account for /admin/login. Change the password before going live.
ADMIN_EMAIL="you@example.com"
ADMIN_PASSWORD="change-me"

# Set automatically by Vercel when a Blob store is connected to the project.
# Leave unset locally — uploads then save to public/uploads instead.
# BLOB_READ_WRITE_TOKEN=""
