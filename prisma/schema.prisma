generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

// type: "MAGNET_SMALL" | "MAGNET_LARGE" | "EVENT_CARD"
model Product {
  id               String  @id @default(auto()) @map("_id") @db.ObjectId
  slug             String  @unique
  name             String
  type             String
  description      String
  price            Int
  compareAtPrice   Int?
  sampleImageUrl   String
  active           Boolean @default(true)
  sortOrder        Int     @default(0)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  orderItems OrderItem[]
}

model Package {
  id             String  @id @default(auto()) @map("_id") @db.ObjectId
  slug           String  @unique
  name           String
  description    String
  price          Int
  compareAtPrice Int?
  badge          String?
  composition    String
  sampleImageUrl String
  photoSlots     Int      @default(1)
  active         Boolean  @default(true)
  sortOrder      Int      @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  orderItems OrderItem[]
}

model Offer {
  id          String    @id @default(auto()) @map("_id") @db.ObjectId
  title       String
  description String
  badgeText   String?
  active      Boolean   @default(true)
  startsAt    DateTime?
  endsAt      DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model Coupon {
  id         String    @id @default(auto()) @map("_id") @db.ObjectId
  code       String    @unique
  percent    Int
  active     Boolean   @default(true)
  expiresAt  DateTime?
  usageLimit Int?
  usedCount  Int       @default(0)
  createdAt  DateTime  @default(now())
}

// status: "PENDING" | "CONFIRMED" | "SHIPPED" | "DELIVERED" | "CANCELLED"
model Order {
  id            String   @id @default(auto()) @map("_id") @db.ObjectId
  orderNumber   String   @unique
  customerName  String
  phone         String
  address       String
  city          String
  notes         String?
  status        String   @default("PENDING")
  subtotal      Int
  discount      Int      @default(0)
  deliveryFee   Int      @default(0)
  total         Int
  paymentMethod String   @default("COD")
  couponCode    String?
  customerId    String?  @db.ObjectId
  customer      Customer? @relation(fields: [customerId], references: [id])
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  items OrderItem[]
}

model Customer {
  id           String   @id @default(auto()) @map("_id") @db.ObjectId
  name         String
  email        String   @unique
  phone        String
  passwordHash String
  address      String?
  city         String?
  createdAt    DateTime @default(now())

  orders Order[]
}

model OrderItem {
  id               String  @id @default(auto()) @map("_id") @db.ObjectId
  orderId          String  @db.ObjectId
  order            Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId        String? @db.ObjectId
  product          Product? @relation(fields: [productId], references: [id])
  packageId        String? @db.ObjectId
  package          Package? @relation(fields: [packageId], references: [id])
  name             String
  size             String?
  quantity         Int     @default(1)
  unitPrice        Int
  uploadedImageUrls String
  customText       String?
}

model AdminUser {
  id           String @id @default(auto()) @map("_id") @db.ObjectId
  email        String @unique
  passwordHash String
  createdAt    DateTime @default(now())
}

// Single-row config document, always addressed by the literal id "singleton".
model Settings {
  id             String @id @map("_id") @default("singleton")
  whatsappNumber String
  instapayNumber String @default("")
  deliveryFee    Int
  updatedAt      DateTime @updatedAt
}
